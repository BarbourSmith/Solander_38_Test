          "interpreterVersion": 1,
          "code": "/**\n * Solander 38 aluminum superstructure framing and forward windscreen.\n * Sources: superstructure framing overview (sheet 1 of 12), center framing planview (rev E sheet 4),\n * starboard framing profile (rev D sheet 2), forward windscreen framing looking aft (rev E sheet 8).\n * The space under the canopy is open: only the forward windscreen closes it off.\n * X forward from transom, +Y to port, Z up from keel baseline (mm).\n *\n * frameTop: top of framing (must match the Solar Canopy atom)\n * wingSlope: wing fall-away outboard (degrees, must match the Solar Canopy atom)\n * cockpitSole: bridge deck top\n */\nfunction run(\n  frameTop: number = 3165,\n  wingSlope: number = 6,\n  cockpitSole: number = 1760,\n): Assembly[] {\n  const box = (x0: number, x1: number, y0: number, y1: number, z0: number, z1: number) =>\n    replicad.makeBox([x0, y0, z0], [x1, y1, z1]);\n  const T4 = 102; // 4x4 tube\n  const T2 = 51; // 2\" dimension\n  const T1 = 25; // 1\" dimension\n  const Zt = frameTop;\n  const tan = Math.tan((wingSlope * Math.PI) / 180);\n  const portHinge = 1168;\n  const stbdHinge = -1162;\n  const tiltPort = (s: any) => s.rotate(-wingSlope, [0, portHinge, Zt], [1, 0, 0]);\n  const tiltStbd = (s: any) => s.rotate(wingSlope, [0, stbdHinge, Zt], [1, 0, 0]);\n  // Underside of the wing framing at a given Y (outboard of the hinge lines)\n  const wingUnder = (y: number) =>\n    Zt - T2 - (Math.abs(y) - (y > 0 ? portHinge : -stbdHinge)) * tan;\n\n  // Hull deckhouse top (same arc as the Hulls atom) for post bases\n  const houseTop = (x: number) => {\n    const [a, b, c] = [[2360, 2000], [4100, 2190], [7950, 1720]];\n    const d = 2 * (a[0] * (b[1] - c[1]) + b[0] * (c[1] - a[1]) + c[0] * (a[1] - b[1]));\n    const s = (p: number[]) => p[0] * p[0] + p[1] * p[1];\n    const ux = (s(a) * (b[1] - c[1]) + s(b) * (c[1] - a[1]) + s(c) * (a[1] - b[1])) / d;\n    const uy = (s(a) * (c[0] - b[0]) + s(b) * (a[0] - c[0]) + s(c) * (b[0] - a[0])) / d;\n    const r = Math.hypot(a[0] - ux, a[1] - uy);\n    return uy + Math.sqrt(r * r - (x - ux) * (x - ux));\n  };\n  const tube = (a: number[], b: number[], r: number) => {\n    const v = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n    const L = Math.hypot(v[0], v[1], v[2]);\n    return replicad.makeCylinder(r, L, a, v.map((c) => c / L));\n  };\n\n  const frame: any[] = [];\n\n  // --- Center section (rev E sheet 4) ---\n  const xArch = 1570; // aft 4x4 arch frame, aft face\n  const xAft = xArch + T4; // 1673: aft end of center section\n  const xD1 = 6693; // D1 2x4 aft face; 197-11/16\" forward of the arch\n  frame.push(box(xAft, xD1, 1137 - T4 / 2, 1137 + T4 / 2, Zt - T4, Zt)); // C3 port 4x4\n  frame.push(box(xAft, xD1, -916 - T4 / 2, -916 + T4 / 2, Zt - T4, Zt)); // C1 4x4\n  frame.push(box(2387, xD1, -1110 - T4 / 2, -1110 + T4 / 2, Zt - T4, Zt)); // C2 stbd 4x4 (169-7/16\")\n  for (const x of [1708, 2749, 3790, 4831, 5872]) {\n    frame.push(box(x - T1 / 2, x + T1 / 2, -916, 1137, Zt - T2, Zt)); // 1x2 transverses, 41\" ctrs\n  }\n  frame.push(box(xD1, xD1 + T2, -1424, 1424, Zt - T4, Zt)); // D1 2x4, 112-1/8\"\n  frame.push(box(xArch, xAft, -1730, 1792, Zt - T4, Zt)); // 4x4 arch frame\n  // Arch posts (4x4) down to the aft hull decks; the starboard one carries the radar mast\n  for (const y of [1742, -1680]) frame.push(box(xArch, xAft, y - T4 / 2, y + T4 / 2, 1370, Zt - T4));\n\n  // --- Beavertail (aft canopy, 122-13/16\" wide) ---\n  const bx0 = -380;\n  for (const y of [1708 - T1, -1424, 668 - T1 / 2, -373 - T1 / 2]) frame.push(box(bx0, xArch, y, y + T1, Zt - T2, Zt));\n  frame.push(box(bx0, bx0 + T1, -1424, 1708, Zt - T2, Zt));\n  // 2\" OD diagonal braces from the beavertail down to the arch posts\n  frame.push(tube([480, 1150, Zt - T2], [1600, 1742, 2300], 25));\n  frame.push(tube([480, -1100, Zt - T2], [1600, -1680, 2300], 25));\n\n  // --- Wings: 1x2 transverses on 41\" ctrs, 1.5x2 outer edge rails, level fore-aft ---\n  const portWing: any[] = [box(2365, 6660, 3240 - 38, 3240, Zt - T2, Zt)];\n  for (const x of [2384, 3425, 4466, 5507, 6548]) portWing.push(box(x - T1 / 2, x + T1 / 2, portHinge, 3240, Zt - T2, Zt));\n  const stbdWing: any[] = [box(2365, 5531, -3220, -3220 + 38, Zt - T2, Zt)];\n  for (const x of [2384, 3425, 4466, 5507]) stbdWing.push(box(x - T1 / 2, x + T1 / 2, -3220, stbdHinge, Zt - T2, Zt));\n  portWing.forEach((s) => frame.push(tiltPort(s)));\n  stbdWing.forEach((s) => frame.push(tiltStbd(s)));\n\n  // --- Posts (1-1/2\" square) from the hull deckhouse tops up to the wings ---\n  // Fore-aft stations from the starboard framing profile: 66-1/8\" then 56-3/16\" apart.\n  const post = (x: number, y: number) => {\n    const s = 38;\n    return box(x - s / 2, x + s / 2, y - s / 2, y + s / 2, houseTop(x) - 20, wingUnder(y));\n  };\n  for (const x of [2390, 4070, 5497]) {\n    frame.push(post(x, 2990), post(x, -2990)); // outboard edge of each deckhouse\n    frame.push(post(x, 1650), post(x, -1650)); // inboard edge of each deckhouse\n  }\n  frame.push(post(6480, 2990)); // port wing runs further forward than starboard\n\n  // --- Forward windscreen: posts A1-A4 raked 74 deg from level (top forward), vertical athwartships ---\n  const rake = 16;\n  const baseX = 6307;\n  const baseZ = 2090;\n  const L = (Zt - T4 - baseZ) / Math.cos((rake * Math.PI) / 180);\n  const raked = (s: any, y: number) => s.rotate(rake, [baseX, y, baseZ], [0, 1, 0]);\n  for (const y of [1405, 133, -133, -1405]) frame.push(raked(box(baseX - 19, baseX + 19, y - 19, y + 19, baseZ, baseZ + L), y));\n  const glass: any[] = [];\n  for (const [y0, y1] of [[152, 1386], [-1386, -152]]) {\n    glass.push(raked(box(baseX - 6, baseX + 6, y0, y1, baseZ + 170, baseZ + L - 30), 0));\n  }\n  // Solid lower windscreen panel and the console / forward coaming it stands on\n  const lower = raked(box(baseX - 6, baseX + 6, -1405, 1405, baseZ, baseZ + 170), 0);\n  const console = box(5900, 6450, -1480, 1480, cockpitSole, baseZ);\n\n  return [\n    new Assembly({\n      geometry: replicad.makeCompound(frame),\n      color: \"#9EA6AE\",\n      tags: [\"superstructure\", \"aluminum framing\"],\n      bom: [\"Aluminum superstructure framing (4x4, 1x2, 1.5x2 tube, posts, braces)\"],\n    }),\n    new Assembly({\n      geometry: replicad.makeCompound(glass),\n      color: \"#8FB3D1\",\n      tags: [\"windscreen\", \"glass\"],\n      bom: [\"Forward windscreen panes (2)\"],\n    }),\n    new Assembly({\n      geometry: replicad.makeCompound([lower, console]),\n      color: \"#F4F1EA\",\n      tags: [\"console\", \"windscreen\"],\n    }),\n  ];\n}",
          "compiledCode": "\"use strict\";\n/**\n * Solander 38 aluminum superstructure framing and forward windscreen.\n * Sources: superstructure framing overview (sheet 1 of 12), center framing planview (rev E sheet 4),\n * starboard framing profile (rev D sheet 2), forward windscreen framing looking aft (rev E sheet 8).\n * The space under the canopy is open: only the forward windscreen closes it off.\n * X forward from transom, +Y to port, Z up from keel baseline (mm).\n *\n * frameTop: top of framing (must match the Solar Canopy atom)\n * wingSlope: wing fall-away outboard (degrees, must match the Solar Canopy atom)\n * cockpitSole: bridge deck top\n */\nfunction run(frameTop = 3165, wingSlope = 6, cockpitSole = 1760) {\n    const box = (x0, x1, y0, y1, z0, z1) => replicad.makeBox([x0, y0, z0], [x1, y1, z1]);\n    const T4 = 102; // 4x4 tube\n    const T2 = 51; // 2\" dimension\n    const T1 = 25; // 1\" dimension\n    const Zt = frameTop;\n    const tan = Math.tan((wingSlope * Math.PI) / 180);\n    const portHinge = 1168;\n    const stbdHinge = -1162;\n    const tiltPort = (s) => s.rotate(-wingSlope, [0, portHinge, Zt], [1, 0, 0]);\n    const tiltStbd = (s) => s.rotate(wingSlope, [0, stbdHinge, Zt], [1, 0, 0]);\n    // Underside of the wing framing at a given Y (outboard of the hinge lines)\n    const wingUnder = (y) => Zt - T2 - (Math.abs(y) - (y > 0 ? portHinge : -stbdHinge)) * tan;\n    // Hull deckhouse top (same arc as the Hulls atom) for post bases\n    const houseTop = (x) => {\n        const [a, b, c] = [[2360, 2000], [4100, 2190], [7950, 1720]];\n        const d = 2 * (a[0] * (b[1] - c[1]) + b[0] * (c[1] - a[1]) + c[0] * (a[1] - b[1]));\n        const s = (p) => p[0] * p[0] + p[1] * p[1];\n        const ux = (s(a) * (b[1] - c[1]) + s(b) * (c[1] - a[1]) + s(c) * (a[1] - b[1])) / d;\n        const uy = (s(a) * (c[0] - b[0]) + s(b) * (a[0] - c[0]) + s(c) * (b[0] - a[0])) / d;\n        const r = Math.hypot(a[0] - ux, a[1] - uy);\n        return uy + Math.sqrt(r * r - (x - ux) * (x - ux));\n    };\n    const tube = (a, b, r) => {\n        const v = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n        const L = Math.hypot(v[0], v[1], v[2]);\n        return replicad.makeCylinder(r, L, a, v.map((c) => c / L));\n    };\n    const frame = [];\n    // --- Center section (rev E sheet 4) ---\n    const xArch = 1570; // aft 4x4 arch frame, aft face\n    const xAft = xArch + T4; // 1673: aft end of center section\n    const xD1 = 6693; // D1 2x4 aft face; 197-11/16\" forward of the arch\n    frame.push(box(xAft, xD1, 1137 - T4 / 2, 1137 + T4 / 2, Zt - T4, Zt)); // C3 port 4x4\n    frame.push(box(xAft, xD1, -916 - T4 / 2, -916 + T4 / 2, Zt - T4, Zt)); // C1 4x4\n    frame.push(box(2387, xD1, -1110 - T4 / 2, -1110 + T4 / 2, Zt - T4, Zt)); // C2 stbd 4x4 (169-7/16\")\n    for (const x of [1708, 2749, 3790, 4831, 5872]) {\n        frame.push(box(x - T1 / 2, x + T1 / 2, -916, 1137, Zt - T2, Zt)); // 1x2 transverses, 41\" ctrs\n    }\n    frame.push(box(xD1, xD1 + T2, -1424, 1424, Zt - T4, Zt)); // D1 2x4, 112-1/8\"\n    frame.push(box(xArch, xAft, -1730, 1792, Zt - T4, Zt)); // 4x4 arch frame\n    // Arch posts (4x4) down to the aft hull decks; the starboard one carries the radar mast\n    for (const y of [1742, -1680])\n        frame.push(box(xArch, xAft, y - T4 / 2, y + T4 / 2, 1370, Zt - T4));\n    // --- Beavertail (aft canopy, 122-13/16\" wide) ---\n    const bx0 = -380;\n    for (const y of [1708 - T1, -1424, 668 - T1 / 2, -373 - T1 / 2])\n        frame.push(box(bx0, xArch, y, y + T1, Zt - T2, Zt));\n    frame.push(box(bx0, bx0 + T1, -1424, 1708, Zt - T2, Zt));\n    // 2\" OD diagonal braces from the beavertail down to the arch posts\n    frame.push(tube([480, 1150, Zt - T2], [1600, 1742, 2300], 25));\n    frame.push(tube([480, -1100, Zt - T2], [1600, -1680, 2300], 25));\n    // --- Wings: 1x2 transverses on 41\" ctrs, 1.5x2 outer edge rails, level fore-aft ---\n    const portWing = [box(2365, 6660, 3240 - 38, 3240, Zt - T2, Zt)];\n    for (const x of [2384, 3425, 4466, 5507, 6548])\n        portWing.push(box(x - T1 / 2, x + T1 / 2, portHinge, 3240, Zt - T2, Zt));\n    const stbdWing = [box(2365, 5531, -3220, -3220 + 38, Zt - T2, Zt)];\n    for (const x of [2384, 3425, 4466, 5507])\n        stbdWing.push(box(x - T1 / 2, x + T1 / 2, -3220, stbdHinge, Zt - T2, Zt));\n    portWing.forEach((s) => frame.push(tiltPort(s)));\n    stbdWing.forEach((s) => frame.push(tiltStbd(s)));\n    // --- Posts (1-1/2\" square) from the hull deckhouse tops up to the wings ---\n    // Fore-aft stations from the starboard framing profile: 66-1/8\" then 56-3/16\" apart.\n    const post = (x, y) => {\n        const s = 38;\n        return box(x - s / 2, x + s / 2, y - s / 2, y + s / 2, houseTop(x) - 20, wingUnder(y));\n    };\n    for (const x of [2390, 4070, 5497]) {\n        frame.push(post(x, 2990), post(x, -2990)); // outboard edge of each deckhouse\n        frame.push(post(x, 1650), post(x, -1650)); // inboard edge of each deckhouse\n    }\n    frame.push(post(6480, 2990)); // port wing runs further forward than starboard\n    // --- Forward windscreen: posts A1-A4 raked 74 deg from level (top forward), vertical athwartships ---\n    const rake = 16;\n    const baseX = 6307;\n    const baseZ = 2090;\n    const L = (Zt - T4 - baseZ) / Math.cos((rake * Math.PI) / 180);\n    const raked = (s, y) => s.rotate(rake, [baseX, y, baseZ], [0, 1, 0]);\n    for (const y of [1405, 133, -133, -1405])\n        frame.push(raked(box(baseX - 19, baseX + 19, y - 19, y + 19, baseZ, baseZ + L), y));\n    const glass = [];\n    for (const [y0, y1] of [[152, 1386], [-1386, -152]]) {\n        glass.push(raked(box(baseX - 6, baseX + 6, y0, y1, baseZ + 170, baseZ + L - 30), 0));\n    }\n    // Solid lower windscreen panel and the console / forward coaming it stands on\n    const lower = raked(box(baseX - 6, baseX + 6, -1405, 1405, baseZ, baseZ + 170), 0);\n    const console = box(5900, 6450, -1480, 1480, cockpitSole, baseZ);\n    return [\n        new Assembly({\n            geometry: replicad.makeCompound(frame),\n            color: \"#9EA6AE\",\n            tags: [\"superstructure\", \"aluminum framing\"],\n            bom: [\"Aluminum superstructure framing (4x4, 1x2, 1.5x2 tube, posts, braces)\"],\n        }),\n        new Assembly({\n            geometry: replicad.makeCompound(glass),\n            color: \"#8FB3D1\",\n            tags: [\"windscreen\", \"glass\"],\n            bom: [\"Forward windscreen panes (2)\"],\n        }),\n        new Assembly({\n            geometry: replicad.makeCompound([lower, console]),\n            color: \"#F4F1EA\",\n            tags: [\"console\", \"windscreen\"],\n        }),\n    ];\n}\n"
        }
