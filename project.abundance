          "interpreterVersion": 1,
          "code": "/**\n * One hull's running gear, from the Solander 38 shaftline alignment and components drawings\n * (profile section at hull centerline, 1\"=1'-0\"):\n *  - propeller shaft 1\" dia at 9.0 deg to level, leaving the hull 80-13/16\" forward of the transom bottom edge\n *  - propeller 40-11/16\" aft of that penetration along the shaft (~15\" dia, 3 blades)\n *  - strut with integrated bearing barrel just forward of the prop\n *  - spade rudder, stock 34-13/16\" forward of the transom bottom edge\n * X forward from transom, Y across the hull centerline, Z up from keel baseline (mm).\n * propDiameter: propeller diameter; pitchAngle: blade pitch at the reference radius (degrees)\n */\nfunction run(\n  propDiameter: number = 380,\n  pitchAngle: number = 30,\n): Assembly[] {\n  const deg = Math.PI / 180;\n  const shaftAngle = 9;\n  const hub = [1055, 0, -8]; // prop hub center\n  const dir = [Math.cos(shaftAngle * deg), 0, Math.sin(shaftAngle * deg)];\n  const along = (d: number) => [hub[0] + dir[0] * d, hub[1], hub[2] + dir[2] * d];\n\n  // Symmetric NACA 00xx section in a horizontal plane at height z, leading edge forward\n  const foil = (le: number, chord: number, t: number, z: number) => {\n    const n = 14;\n    const up: number[][] = [];\n    const lo: number[][] = [];\n    for (let i = 0; i <= n; i++) {\n      const x = (1 - Math.cos((i / n) * Math.PI)) / 2;\n      const yt = 5 * t * chord *\n        (0.2969 * Math.sqrt(x) - 0.126 * x - 0.3516 * x * x + 0.2843 * x ** 3 - 0.1036 * x ** 4);\n      up.push([le - x * chord, yt, z]);\n      lo.push([le - x * chord, -yt, z]);\n    }\n    const cfg = { tolerance: 0.05, degMin: 3, degMax: 3 };\n    return replicad.assembleWire([\n      replicad.makeBSplineApproximation(up, cfg),\n      replicad.makeBSplineApproximation(lo.reverse(), cfg),\n    ]);\n  };\n\n  // Spade rudder: straight-ish leading edge, rounded-off bottom (stock ~25% chord aft of LE)\n  const rudder = replicad.loft([\n    foil(850, 130, 0.12, -241),\n    foil(915, 240, 0.12, -150),\n    foil(960, 310, 0.12, 100),\n    foil(972, 334, 0.12, 430),\n  ], { ruled: false });\n\n  // Strut blade from the hull bottom down to the bearing barrel\n  const strut = replicad.loft([\n    foil(1340, 150, 0.16, 20),\n    foil(1390, 210, 0.16, 320),\n  ], { ruled: false });\n  const barrel = replicad.makeCylinder(38, 260, along(170), dir);\n  const shaft = replicad.makeCylinder(12.7, 1300, along(-40), dir);\n\n  // 3-blade propeller built on the +X axis, then tilted to the shaft line\n  const r = propDiameter / 2;\n  const bladeLen = r - 40;\n  let blades: any[] = [];\n  for (let k = 0; k < 3; k++) {\n    const blade = replicad\n      .drawEllipse(bladeLen / 2, bladeLen * 0.3)\n      .rotate(90)\n      .translate(0, 40 + bladeLen / 2)\n      .sketchOnPlane(\"YZ\")\n      .extrude(8)\n      .translate(-4, 0, 0)\n      .rotate(pitchAngle, [0, 0, 0], [0, 0, 1])\n      .rotate(120 * k, [0, 0, 0], [1, 0, 0]);\n    blades.push(blade);\n  }\n  const hubBody = replicad.makeCylinder(42, 140, [-90, 0, 0], [1, 0, 0]);\n  const prop = replicad\n    .makeCompound([hubBody, ...blades])\n    .rotate(-shaftAngle, [0, 0, 0], [0, 1, 0])\n    .translate(hub[0], hub[1], hub[2]);\n\n  return [\n    new Assembly({ geometry: rudder, color: \"#B08D57\", tags: [\"rudder\"], bom: [\"Spade rudder\"] }),\n    new Assembly({ geometry: prop, color: \"#C9A227\", tags: [\"propeller\", \"bronze\"], bom: [\"3-blade bronze propeller ~15\\\"\"] }),\n    new Assembly({\n      geometry: replicad.makeCompound([shaft, barrel, strut]),\n      color: \"#C8CCD0\",\n      tags: [\"shaft\", \"strut\", \"stainless\"],\n      bom: [\"1\\\" propeller shaft\", \"Strut with integrated bearing\"],\n    }),\n  ];\n}",
          "compiledCode": "\"use strict\";\n/**\n * One hull's running gear, from the Solander 38 shaftline alignment and components drawings\n * (profile section at hull centerline, 1\"=1'-0\"):\n *  - propeller shaft 1\" dia at 9.0 deg to level, leaving the hull 80-13/16\" forward of the transom bottom edge\n *  - propeller 40-11/16\" aft of that penetration along the shaft (~15\" dia, 3 blades)\n *  - strut with integrated bearing barrel just forward of the prop\n *  - spade rudder, stock 34-13/16\" forward of the transom bottom edge\n * X forward from transom, Y across the hull centerline, Z up from keel baseline (mm).\n * propDiameter: propeller diameter; pitchAngle: blade pitch at the reference radius (degrees)\n */\nfunction run(propDiameter = 380, pitchAngle = 30) {\n    const deg = Math.PI / 180;\n    const shaftAngle = 9;\n    const hub = [1055, 0, -8]; // prop hub center\n    const dir = [Math.cos(shaftAngle * deg), 0, Math.sin(shaftAngle * deg)];\n    const along = (d) => [hub[0] + dir[0] * d, hub[1], hub[2] + dir[2] * d];\n    // Symmetric NACA 00xx section in a horizontal plane at height z, leading edge forward\n    const foil = (le, chord, t, z) => {\n        const n = 14;\n        const up = [];\n        const lo = [];\n        for (let i = 0; i <= n; i++) {\n            const x = (1 - Math.cos((i / n) * Math.PI)) / 2;\n            const yt = 5 * t * chord *\n                (0.2969 * Math.sqrt(x) - 0.126 * x - 0.3516 * x * x + 0.2843 * x ** 3 - 0.1036 * x ** 4);\n            up.push([le - x * chord, yt, z]);\n            lo.push([le - x * chord, -yt, z]);\n        }\n        const cfg = { tolerance: 0.05, degMin: 3, degMax: 3 };\n        return replicad.assembleWire([\n            replicad.makeBSplineApproximation(up, cfg),\n            replicad.makeBSplineApproximation(lo.reverse(), cfg),\n        ]);\n    };\n    // Spade rudder: straight-ish leading edge, rounded-off bottom (stock ~25% chord aft of LE)\n    const rudder = replicad.loft([\n        foil(850, 130, 0.12, -241),\n        foil(915, 240, 0.12, -150),\n        foil(960, 310, 0.12, 100),\n        foil(972, 334, 0.12, 430),\n    ], { ruled: false });\n    // Strut blade from the hull bottom down to the bearing barrel\n    const strut = replicad.loft([\n        foil(1340, 150, 0.16, 20),\n        foil(1390, 210, 0.16, 320),\n    ], { ruled: false });\n    const barrel = replicad.makeCylinder(38, 260, along(170), dir);\n    const shaft = replicad.makeCylinder(12.7, 1300, along(-40), dir);\n    // 3-blade propeller built on the +X axis, then tilted to the shaft line\n    const r = propDiameter / 2;\n    const bladeLen = r - 40;\n    let blades = [];\n    for (let k = 0; k < 3; k++) {\n        const blade = replicad\n            .drawEllipse(bladeLen / 2, bladeLen * 0.3)\n            .rotate(90)\n            .translate(0, 40 + bladeLen / 2)\n            .sketchOnPlane(\"YZ\")\n            .extrude(8)\n            .translate(-4, 0, 0)\n            .rotate(pitchAngle, [0, 0, 0], [0, 0, 1])\n            .rotate(120 * k, [0, 0, 0], [1, 0, 0]);\n        blades.push(blade);\n    }\n    const hubBody = replicad.makeCylinder(42, 140, [-90, 0, 0], [1, 0, 0]);\n    const prop = replicad\n        .makeCompound([hubBody, ...blades])\n        .rotate(-shaftAngle, [0, 0, 0], [0, 1, 0])\n        .translate(hub[0], hub[1], hub[2]);\n    return [\n        new Assembly({ geometry: rudder, color: \"#B08D57\", tags: [\"rudder\"], bom: [\"Spade rudder\"] }),\n        new Assembly({ geometry: prop, color: \"#C9A227\", tags: [\"propeller\", \"bronze\"], bom: [\"3-blade bronze propeller ~15\\\"\"] }),\n        new Assembly({\n            geometry: replicad.makeCompound([shaft, barrel, strut]),\n            color: \"#C8CCD0\",\n            tags: [\"shaft\", \"strut\", \"stainless\"],\n            bom: [\"1\\\" propeller shaft\", \"Strut with integrated bearing\"],\n        }),\n    ];\n}\n"
        },
