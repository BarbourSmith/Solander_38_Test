            {
              "name": "panelY",
              "ioValue": 2020
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * A row of solar panels (Solander 38 has 15 in total, ~7 kW).\n * Panel 1 is centered on the origin; panel i is offset by i * (pitchX, pitchY).\n */\nfunction run(\n  count: number = 4,\n  pitchX: number = 1040,\n  pitchY: number = 0,\n  panelX: number = 1000,\n  panelY: number = 2020,\n  thickness: number = 40,\n): Assembly[] {\n  const panels: Assembly[] = [];\n  for (let i = 0; i < count; i++) {\n    // makeBaseBox is centered in XY with its base on Z = 0\n    const p = replicad\n      .makeBaseBox(panelX, panelY, thickness)\n      .translate(i * pitchX, i * pitchY, 0);\n    panels.push(new Assembly({\n      geometry: p,\n      color: \"#1F3A5F\",\n      tags: [\"solar panel\"],\n      bom: [\"Solar panel\"],\n    }));\n  }\n  return panels;\n}",
          "compiledCode": "\"use strict\";\n/**\n * A row of solar panels (Solander 38 has 15 in total, ~7 kW).\n * Panel 1 is centered on the origin; panel i is offset by i * (pitchX, pitchY).\n */\nfunction run(count = 4, pitchX = 1040, pitchY = 0, panelX = 1000, panelY = 2020, thickness = 40) {\n    const panels = [];\n    for (let i = 0; i < count; i++) {\n        // makeBaseBox is centered in XY with its base on Z = 0\n        const p = replicad\n            .makeBaseBox(panelX, panelY, thickness)\n            .translate(i * pitchX, i * pitchY, 0);\n        panels.push(new Assembly({\n            geometry: p,\n            color: \"#1F3A5F\",\n            tags: [\"solar panel\"],\n            bom: [\"Solar panel\"],\n        }));\n    }\n    return panels;\n}\n"
