          "interpreterVersion": 1,
          "code": "/**\n * One Solander 38 (Maine Cat 38) hull, lofted through cross-sections\n * scaled off the 3/8\"=1'-0\" overview drawings at solander38.com.\n * X = forward from transom (mm), Y = across hull centerline, Z = up from keel baseline.\n * Returns the hull, its deckhouse portlights, and the bow/stern rails.\n */\nfunction run(\n  railHeight: number = 700,\n  color: string = \"#F4F1EA\",\n): Assembly[] {\n  // Stations: [x from transom, deck half-beam, keel z, sheer z]\n  const stations = [\n    [0, 560, 588, 1175],\n    [1000, 690, 330, 1300],\n    [2074, 767, 104, 1420],\n    [3500, 815, 20, 1600],\n    [4840, 837, 0, 1715],\n    [6200, 830, 0, 1730],\n    [7605, 805, 14, 1740],\n    [8700, 640, 50, 1750],\n    [9680, 420, 104, 1755],\n    [10600, 190, 150, 1760],\n    [11250, 30, 230, 1763],\n  ];\n  const lerp = (x: number, i: number) => {\n    for (let k = 0; k < stations.length - 1; k++) {\n      const [x0, x1] = [stations[k][0], stations[k + 1][0]];\n      if (x >= x0 && x <= x1) {\n        const t = (x - x0) / (x1 - x0);\n        return stations[k][i] + t * (stations[k + 1][i] - stations[k][i]);\n      }\n    }\n    return stations[stations.length - 1][i];\n  };\n\n  // Fair the station table: resample every column along a Catmull-Rom spline so the\n  // loft passes through closely spaced, smoothly varying sections instead of\n  // overshooting between the sparse measured stations.\n  const cr = (p0: number, p1: number, p2: number, p3: number, t: number) =>\n    0.5 * (2 * p1 + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t +\n      (-p0 + 3 * p1 - 3 * p2 + p3) * t * t * t);\n  const S = (i: number) => stations[Math.max(0, Math.min(stations.length - 1, i))];\n  const faired: number[][] = [];\n  for (let k = 0; k < stations.length - 1; k++) {\n    for (const t of [0, 1 / 3, 2 / 3]) {\n      faired.push([0, 1, 2, 3].map((c) => cr(S(k - 1)[c], S(k)[c], S(k + 1)[c], S(k + 2)[c], t)));\n    }\n  }\n  faired.push(stations[stations.length - 1]);\n\n  // Wine-glass section from starboard sheer down to the keel:\n  // flaring topsides, a knuckle under the bridge deck, then a narrow rounded underbody.\n  // [fraction of half-beam, fraction of depth from keel]\n  const half = [\n    [0.98, 1.0], [1.0, 0.85], [0.98, 0.7], [0.88, 0.6], [0.66, 0.5],\n    [0.58, 0.38], [0.53, 0.25], [0.42, 0.12], [0.24, 0.03],\n  ];\n\n  // Each section is one smooth B-spline (sheer to sheer around the keel) closed by the deck line\n  const wires = faired.map(([x, b, zk, zs]) => {\n    const d = zs - zk;\n    const p = ([fy, fz]: number[], side: number) => [x, side * fy * b, zk + fz * d];\n    const pts = [\n      ...half.map((h) => p(h, 1)),\n      [x, 0, zk],\n      ...[...half].reverse().map((h) => p(h, -1)),\n    ];\n    const curve = replicad.makeBSplineApproximation(pts, { tolerance: 0.1, degMin: 3, degMax: 3 });\n    const deck = replicad.makeLine(pts[pts.length - 1], pts[0]);\n    return replicad.assembleWire([curve, deck]);\n  });\n  let hull = replicad.loft(wires, { ruled: false });\n\n  // Raised deckhouse molded into each hull: profile from the overview drawings,\n  // full hull width in plan (superstructure framing plan), inset 60 mm from the sheer.\n  const houseProfile = replicad\n    .draw([2300, 1300])\n    .lineTo([2300, 1500])\n    .lineTo([2360, 2000])\n    .threePointsArcTo([7950, 1720], [4100, 2190])\n    .lineTo([7950, 1300])\n    .close()\n    .sketchOnPlane(\"XZ\")\n    .extrude(-2000)\n    .translate(0, -1000, 0);\n  const xs: number[] = [];\n  for (let x = 2250; x <= 8050; x += 250) xs.push(x);\n  let plan = replicad.draw([xs[0], lerp(xs[0], 1) - 60]);\n  for (const x of xs.slice(1)) plan = plan.lineTo([x, lerp(x, 1) - 60]);\n  for (const x of [...xs].reverse()) plan = plan.lineTo([x, -(lerp(x, 1) - 60)]);\n  const housePlan = plan.close().sketchOnPlane(\"XY\", 1300).extrude(1100);\n  hull = hull.fuse(houseProfile.intersect(housePlan));\n\n  // Oval portlight in each deckhouse side\n  const port = replicad\n    .drawRoundedRectangle(1030, 170, 85)\n    .sketchOnPlane(\"XZ\")\n    .extrude(-1600)\n    .translate(4780, -800, 1885);\n\n  // Deck-edge rails: stanchions plus a top rail, forward decks and aft decks\n  const edge = (x: number, side: number) => [x, side * 0.93 * lerp(x, 1), lerp(x, 3)];\n  const up = (p: number[]) => [p[0], p[1], p[2] + railHeight];\n  const tube = (a: number[], b: number[], r: number) => {\n    const v = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n    const L = Math.hypot(v[0], v[1], v[2]);\n    return replicad.makeCylinder(r, L, a, v.map((c) => c / L));\n  };\n  const rails: any[] = [];\n  const run = (xs: number[], side: number) => {\n    const pts = xs.map((x) => edge(x, side));\n    pts.forEach((p) => rails.push(tube(p, up(p), 13)));\n    for (let i = 0; i < pts.length - 1; i++) rails.push(tube(up(pts[i]), up(pts[i + 1]), 13));\n    return pts;\n  };\n  const fwd = [7950, 8800, 9700, 10500];\n  const aft = [250, 1150, 2100];\n  for (const side of [1, -1]) {\n    const f = run(fwd, side);\n    run(aft, side);\n    // Bow pulpit: carry the top rail round to the stem\n    rails.push(tube(up(f[f.length - 1]), [11150, 0, lerp(11150, 3) + railHeight], 13));\n  }\n  // Stern rail across the transom\n  rails.push(tube(up(edge(250, 1)), up(edge(250, -1)), 13));\n\n  return [\n    new Assembly({\n      geometry: hull,\n      color: color,\n      tags: [\"hull\", \"fiberglass\"],\n      bom: [\"Maine Cat 38 hull, foam-cored fiberglass\"],\n    }),\n    new Assembly({ geometry: port.cut(hull), color: \"#2B3A4A\", tags: [\"portlight\"] }),\n    new Assembly({\n      geometry: replicad.makeCompound(rails),\n      color: \"#C8CCD0\",\n      tags: [\"railing\", \"stainless\"],\n      bom: [\"Stainless deck rails and stanchions (per hull)\"],\n    }),\n  ];\n}",
          "compiledCode": "\"use strict\";\n/**\n * One Solander 38 (Maine Cat 38) hull, lofted through cross-sections\n * scaled off the 3/8\"=1'-0\" overview drawings at solander38.com.\n * X = forward from transom (mm), Y = across hull centerline, Z = up from keel baseline.\n * Returns the hull, its deckhouse portlights, and the bow/stern rails.\n */\nfunction run(railHeight = 700, color = \"#F4F1EA\") {\n    // Stations: [x from transom, deck half-beam, keel z, sheer z]\n    const stations = [\n        [0, 560, 588, 1175],\n        [1000, 690, 330, 1300],\n        [2074, 767, 104, 1420],\n        [3500, 815, 20, 1600],\n        [4840, 837, 0, 1715],\n        [6200, 830, 0, 1730],\n        [7605, 805, 14, 1740],\n        [8700, 640, 50, 1750],\n        [9680, 420, 104, 1755],\n        [10600, 190, 150, 1760],\n        [11250, 30, 230, 1763],\n    ];\n    const lerp = (x, i) => {\n        for (let k = 0; k < stations.length - 1; k++) {\n            const [x0, x1] = [stations[k][0], stations[k + 1][0]];\n            if (x >= x0 && x <= x1) {\n                const t = (x - x0) / (x1 - x0);\n                return stations[k][i] + t * (stations[k + 1][i] - stations[k][i]);\n            }\n        }\n        return stations[stations.length - 1][i];\n    };\n    // Fair the station table: resample every column along a Catmull-Rom spline so the\n    // loft passes through closely spaced, smoothly varying sections instead of\n    // overshooting between the sparse measured stations.\n    const cr = (p0, p1, p2, p3, t) => 0.5 * (2 * p1 + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t +\n        (-p0 + 3 * p1 - 3 * p2 + p3) * t * t * t);\n    const S = (i) => stations[Math.max(0, Math.min(stations.length - 1, i))];\n    const faired = [];\n    for (let k = 0; k < stations.length - 1; k++) {\n        for (const t of [0, 1 / 3, 2 / 3]) {\n            faired.push([0, 1, 2, 3].map((c) => cr(S(k - 1)[c], S(k)[c], S(k + 1)[c], S(k + 2)[c], t)));\n        }\n    }\n    faired.push(stations[stations.length - 1]);\n    // Wine-glass section from starboard sheer down to the keel:\n    // flaring topsides, a knuckle under the bridge deck, then a narrow rounded underbody.\n    // [fraction of half-beam, fraction of depth from keel]\n    const half = [\n        [0.98, 1.0], [1.0, 0.85], [0.98, 0.7], [0.88, 0.6], [0.66, 0.5],\n        [0.58, 0.38], [0.53, 0.25], [0.42, 0.12], [0.24, 0.03],\n    ];\n    // Each section is one smooth B-spline (sheer to sheer around the keel) closed by the deck line\n    const wires = faired.map(([x, b, zk, zs]) => {\n        const d = zs - zk;\n        const p = ([fy, fz], side) => [x, side * fy * b, zk + fz * d];\n        const pts = [\n            ...half.map((h) => p(h, 1)),\n            [x, 0, zk],\n            ...[...half].reverse().map((h) => p(h, -1)),\n        ];\n        const curve = replicad.makeBSplineApproximation(pts, { tolerance: 0.1, degMin: 3, degMax: 3 });\n        const deck = replicad.makeLine(pts[pts.length - 1], pts[0]);\n        return replicad.assembleWire([curve, deck]);\n    });\n    let hull = replicad.loft(wires, { ruled: false });\n    // Raised deckhouse molded into each hull: profile from the overview drawings,\n    // full hull width in plan (superstructure framing plan), inset 60 mm from the sheer.\n    const houseProfile = replicad\n        .draw([2300, 1300])\n        .lineTo([2300, 1500])\n        .lineTo([2360, 2000])\n        .threePointsArcTo([7950, 1720], [4100, 2190])\n        .lineTo([7950, 1300])\n        .close()\n        .sketchOnPlane(\"XZ\")\n        .extrude(-2000)\n        .translate(0, -1000, 0);\n    const xs = [];\n    for (let x = 2250; x <= 8050; x += 250)\n        xs.push(x);\n    let plan = replicad.draw([xs[0], lerp(xs[0], 1) - 60]);\n    for (const x of xs.slice(1))\n        plan = plan.lineTo([x, lerp(x, 1) - 60]);\n    for (const x of [...xs].reverse())\n        plan = plan.lineTo([x, -(lerp(x, 1) - 60)]);\n    const housePlan = plan.close().sketchOnPlane(\"XY\", 1300).extrude(1100);\n    hull = hull.fuse(houseProfile.intersect(housePlan));\n    // Oval portlight in each deckhouse side\n    const port = replicad\n        .drawRoundedRectangle(1030, 170, 85)\n        .sketchOnPlane(\"XZ\")\n        .extrude(-1600)\n        .translate(4780, -800, 1885);\n    // Deck-edge rails: stanchions plus a top rail, forward decks and aft decks\n    const edge = (x, side) => [x, side * 0.93 * lerp(x, 1), lerp(x, 3)];\n    const up = (p) => [p[0], p[1], p[2] + railHeight];\n    const tube = (a, b, r) => {\n        const v = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n        const L = Math.hypot(v[0], v[1], v[2]);\n        return replicad.makeCylinder(r, L, a, v.map((c) => c / L));\n    };\n    const rails = [];\n    const run = (xs, side) => {\n        const pts = xs.map((x) => edge(x, side));\n        pts.forEach((p) => rails.push(tube(p, up(p), 13)));\n        for (let i = 0; i < pts.length - 1; i++)\n            rails.push(tube(up(pts[i]), up(pts[i + 1]), 13));\n        return pts;\n    };\n    const fwd = [7950, 8800, 9700, 10500];\n    const aft = [250, 1150, 2100];\n    for (const side of [1, -1]) {\n        const f = run(fwd, side);\n        run(aft, side);\n        // Bow pulpit: carry the top rail round to the stem\n        rails.push(tube(up(f[f.length - 1]), [11150, 0, lerp(11150, 3) + railHeight], 13));\n    }\n    // Stern rail across the transom\n    rails.push(tube(up(edge(250, 1)), up(edge(250, -1)), 13));\n    return [\n        new Assembly({\n            geometry: hull,\n            color: color,\n            tags: [\"hull\", \"fiberglass\"],\n            bom: [\"Maine Cat 38 hull, foam-cored fiberglass\"],\n        }),\n        new Assembly({ geometry: port.cut(hull), color: \"#2B3A4A\", tags: [\"portlight\"] }),\n        new Assembly({\n            geometry: replicad.makeCompound(rails),\n            color: \"#C8CCD0\",\n            tags: [\"railing\", \"stainless\"],\n            bom: [\"Stainless deck rails and stanchions (per hull)\"],\n        }),\n    ];\n}\n"
