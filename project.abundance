    {
      "atomType": "Molecule",
      "x": 0.5,
      "y": 0.2,
      "uniqueID": "id-7096",
      "name": "Solar Canopy",
      "topLevel": false,
      "allAtoms": [
        {
          "atomType": "Output",
          "x": 1,
          "y": 0.5,
          "uniqueID": "id-7098",
          "ioValues": [
            {
              "name": "number or geometry",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ]
        },
        {
          "atomType": "Code",
          "x": 0.4,
          "y": 0.5,
          "uniqueID": "id-7100",
          "ioValues": [
            {
              "name": "frameTop",
              "ioValue": 3165
            },
            {
              "name": "wingSlope",
              "ioValue": 6
            },
            {
              "name": "plateThickness",
              "ioValue": 6.35
            },
            {
              "name": "panelThickness",
              "ioValue": 35
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Solander 38 solar canopy: 1/4\" aluminum canopy plates (P1 beavertail, P2 center,\n * starboard skylight strip, P3 starboard wing, P4 port wing) with rounded CNC cut-outs,\n * and the 15 solar panels bolted over them.\n * Sources: canopy plating locations (addendum rev G), center framing planview (rev E),\n * solar panel location/install sheets 1-2, overview elevation views.\n * X forward from transom, +Y to port, Z up from keel baseline (mm).\n *\n * frameTop: top of the 4x4 / 1x2 framing = underside of the canopy plate\n * wingSlope: wings fall away outboard (degrees); they are level fore-aft\n * plateThickness: 1/4\" canopy plate; panelThickness: 1-3/8\" panel frame\n */\nfunction run(\n  frameTop: number = 3165,\n  wingSlope: number = 6,\n  plateThickness: number = 6.35,\n  panelThickness: number = 35,\n): Assembly[] {\n  const IN = 25.4;\n  const panelFA = 40.875 * IN; // 1038 mm fore-aft\n  const panelAT = 82.4375 * IN; // 2094 mm athwartships\n  const zPanel = frameTop + plateThickness;\n\n  // Wings hinge on their inboard edges and fall away outboard\n  const portHinge = 1168; // P2 port edge, flush with port face of 4x4 C3\n  const stbdHinge = -1162; // inboard edge of P3\n  const tiltPort = (s: any) => s.rotate(-wingSlope, [0, portHinge, frameTop], [1, 0, 0]);\n  const tiltStbd = (s: any) => s.rotate(wingSlope, [0, stbdHinge, frameTop], [1, 0, 0]);\n\n  const plate = (outline: any, cuts: number[][]) => {\n    let d = outline;\n    for (const [cx, cy, w, l] of cuts) {\n      d = d.cut(replicad.drawRoundedRectangle(w, l, Math.min(w, l) * 0.32).translate(cx, cy));\n    }\n    return d.sketchOnPlane(\"XY\", frameTop).extrude(plateThickness);\n  };\n\n  // Panel centers. Center and wings: panels centered between 1x2 transverse frames on 41\" centers.\n  const p2X = [2229, 3270, 4311, 5352, 6393];\n  const p2Y = 142; // port edge flush with port edge of P2\n  const wingX = [2905, 3946, 4987, 6028];\n  const portY = 2215;\n  const stbdY = -2216;\n  const beaverX = 650;\n  const beaverY = [1188, 147, -894]; // 40-15/16\", 41\", 40-15/16\" bays across 122-13/16\"\n\n  // --- Plates ---\n  const P1 = plate(\n    replicad.drawRectangle(2053, 3132).translate(646.5, 142),\n    beaverY.map((y) => [beaverX, y, 1900, 950]),\n  );\n  const P2 = plate(\n    replicad.draw([1673, -954]).lineTo([1673, 1168]).lineTo([6985, 1168])\n      .threePointsArcTo([6880, -954], [7010, 100]).close(),\n    p2X.map((x, i) => (i < 4 ? [x, 145, 950, 1830] : [6243, 145, 690, 1830])),\n  );\n  const strip = plate(\n    replicad.draw([2365, -954]).lineTo([6880, -954]).lineTo([6860, -1162]).lineTo([2365, -1162]).close(),\n    [],\n  ).cut(replicad.makeBox([2960, -1120, frameTop - 1], [6015, -1000, frameTop + 10]));\n  const skylight = replicad.makeBox([2960, -1120, frameTop], [6015, -1000, frameTop + plateThickness]);\n  const P4 = tiltPort(plate(\n    replicad.draw([2365, 1168]).lineTo([2365, 3290]).lineTo([6660, 3290])\n      .threePointsArcTo([6985, 1168], [6850, 2300]).close(),\n    wingX.map((x) => [x, portY, 950, 1830]),\n  ));\n  const P3 = tiltStbd(plate(\n    replicad.draw([2365, -1162]).lineTo([5531, -1162]).lineTo([5531, -3270]).lineTo([2365, -3270]).close(),\n    wingX.slice(0, 3).map((x) => [x, stbdY, 950, 1830]),\n  ));\n\n  // --- Panels ---\n  const panel = (cx: number, cy: number, fa: number, at: number) =>\n    replicad.makeBaseBox(fa, at, panelThickness).translate(cx, cy, zPanel);\n  const panels: any[] = [\n    ...beaverY.map((y) => panel(beaverX, y, panelAT, panelFA)), // long axis fore-aft on the beavertail\n    ...p2X.map((x) => panel(x, p2Y, panelFA, panelAT)),\n    ...wingX.map((x) => tiltPort(panel(x, portY, panelFA, panelAT))),\n    ...wingX.slice(0, 3).map((x) => tiltStbd(panel(x, stbdY, panelFA, panelAT))),\n  ];\n\n  return [\n    new Assembly({\n      geometry: replicad.makeCompound([P1, P2, strip, P3, P4]),\n      color: \"#BFC5CB\",\n      tags: [\"canopy plate\", \"aluminum\"],\n      bom: [\"1/4\\\" aluminum canopy plates P1-P4 with CNC solar cut-outs\"],\n    }),\n    new Assembly({ geometry: skylight, color: \"#7FA3C4\", tags: [\"skylight\"] }),\n    ...panels.map((g) =>\n      new Assembly({\n        geometry: g,\n        color: \"#1C2B45\",\n        tags: [\"solar panel\"],\n        bom: [\"Solar panel 40-7/8\\\" x 82-7/16\\\"\"],\n      }),\n    ),\n  ];\n}",
          "compiledCode": "\"use strict\";\n/**\n * Solander 38 solar canopy: 1/4\" aluminum canopy plates (P1 beavertail, P2 center,\n * starboard skylight strip, P3 starboard wing, P4 port wing) with rounded CNC cut-outs,\n * and the 15 solar panels bolted over them.\n * Sources: canopy plating locations (addendum rev G), center framing planview (rev E),\n * solar panel location/install sheets 1-2, overview elevation views.\n * X forward from transom, +Y to port, Z up from keel baseline (mm).\n *\n * frameTop: top of the 4x4 / 1x2 framing = underside of the canopy plate\n * wingSlope: wings fall away outboard (degrees); they are level fore-aft\n * plateThickness: 1/4\" canopy plate; panelThickness: 1-3/8\" panel frame\n */\nfunction run(frameTop = 3165, wingSlope = 6, plateThickness = 6.35, panelThickness = 35) {\n    const IN = 25.4;\n    const panelFA = 40.875 * IN; // 1038 mm fore-aft\n    const panelAT = 82.4375 * IN; // 2094 mm athwartships\n    const zPanel = frameTop + plateThickness;\n    // Wings hinge on their inboard edges and fall away outboard\n    const portHinge = 1168; // P2 port edge, flush with port face of 4x4 C3\n    const stbdHinge = -1162; // inboard edge of P3\n    const tiltPort = (s) => s.rotate(-wingSlope, [0, portHinge, frameTop], [1, 0, 0]);\n    const tiltStbd = (s) => s.rotate(wingSlope, [0, stbdHinge, frameTop], [1, 0, 0]);\n    const plate = (outline, cuts) => {\n        let d = outline;\n        for (const [cx, cy, w, l] of cuts) {\n            d = d.cut(replicad.drawRoundedRectangle(w, l, Math.min(w, l) * 0.32).translate(cx, cy));\n        }\n        return d.sketchOnPlane(\"XY\", frameTop).extrude(plateThickness);\n    };\n    // Panel centers. Center and wings: panels centered between 1x2 transverse frames on 41\" centers.\n    const p2X = [2229, 3270, 4311, 5352, 6393];\n    const p2Y = 142; // port edge flush with port edge of P2\n    const wingX = [2905, 3946, 4987, 6028];\n    const portY = 2215;\n    const stbdY = -2216;\n    const beaverX = 650;\n    const beaverY = [1188, 147, -894]; // 40-15/16\", 41\", 40-15/16\" bays across 122-13/16\"\n    // --- Plates ---\n    const P1 = plate(replicad.drawRectangle(2053, 3132).translate(646.5, 142), beaverY.map((y) => [beaverX, y, 1900, 950]));\n    const P2 = plate(replicad.draw([1673, -954]).lineTo([1673, 1168]).lineTo([6985, 1168])\n        .threePointsArcTo([6880, -954], [7010, 100]).close(), p2X.map((x, i) => (i < 4 ? [x, 145, 950, 1830] : [6243, 145, 690, 1830])));\n    const strip = plate(replicad.draw([2365, -954]).lineTo([6880, -954]).lineTo([6860, -1162]).lineTo([2365, -1162]).close(), []).cut(replicad.makeBox([2960, -1120, frameTop - 1], [6015, -1000, frameTop + 10]));\n    const skylight = replicad.makeBox([2960, -1120, frameTop], [6015, -1000, frameTop + plateThickness]);\n    const P4 = tiltPort(plate(replicad.draw([2365, 1168]).lineTo([2365, 3290]).lineTo([6660, 3290])\n        .threePointsArcTo([6985, 1168], [6850, 2300]).close(), wingX.map((x) => [x, portY, 950, 1830])));\n    const P3 = tiltStbd(plate(replicad.draw([2365, -1162]).lineTo([5531, -1162]).lineTo([5531, -3270]).lineTo([2365, -3270]).close(), wingX.slice(0, 3).map((x) => [x, stbdY, 950, 1830])));\n    // --- Panels ---\n    const panel = (cx, cy, fa, at) => replicad.makeBaseBox(fa, at, panelThickness).translate(cx, cy, zPanel);\n    const panels = [\n        ...beaverY.map((y) => panel(beaverX, y, panelAT, panelFA)), // long axis fore-aft on the beavertail\n        ...p2X.map((x) => panel(x, p2Y, panelFA, panelAT)),\n        ...wingX.map((x) => tiltPort(panel(x, portY, panelFA, panelAT))),\n        ...wingX.slice(0, 3).map((x) => tiltStbd(panel(x, stbdY, panelFA, panelAT))),\n    ];\n    return [\n        new Assembly({\n            geometry: replicad.makeCompound([P1, P2, strip, P3, P4]),\n            color: \"#BFC5CB\",\n            tags: [\"canopy plate\", \"aluminum\"],\n            bom: [\"1/4\\\" aluminum canopy plates P1-P4 with CNC solar cut-outs\"],\n        }),\n        new Assembly({ geometry: skylight, color: \"#7FA3C4\", tags: [\"skylight\"] }),\n        ...panels.map((g) => new Assembly({\n            geometry: g,\n            color: \"#1C2B45\",\n            tags: [\"solar panel\"],\n            bom: [\"Solar panel 40-7/8\\\" x 82-7/16\\\"\"],\n        })),\n    ];\n}\n"
        }
      ],
